---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.tsx";
import Footer from "../../components/Footer.astro";
import Talk from "../../components/Talk.astro";
import MobilePagination from "../../components/MobilePagination.astro";
import DesktopPagination from "../../components/DesktopPagination.astro";
import {
  getPagination,
  getAllTalksSorted,
  getPageFromCollection,
  getTalksWithExcerpts,
} from "../../lib/helpers";

const sortedTalks = await getAllTalksSorted();
const totalTalks = sortedTalks.length;
const { currentPage, noOfPages } = getPagination(1, totalTalks);
const pageTalks = getPageFromCollection<"talks">(sortedTalks, 1);
const talksWithExcerpts = getTalksWithExcerpts(pageTalks);
const { href } = Astro.url;
---

<Layout
  title="Public Speaking"
  description="Speaking at events, meetups, and conferences"
  url={href}
>
  <Header client:load />

  <div class="container mx-auto px-4 py-8 sm:px-6 md:py-12 lg:px-8 xl:max-w-7xl">
    <header class="mb-8">
      <h1 class="mb-3 text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-black dark:text-white">
        Talks 🥳
      </h1>
      <h2 class="text-xl sm:text-2xl font-medium leading-relaxed text-gray-700 dark:text-gray-300">
        Speaking at events, meetups, and conferences
      </h2>
    </header>

    <!-- Talks  -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-8">
      {talksWithExcerpts.map(
        ({ id, excerpt, data: { title, type, eventLink, date, event, video, image, slidesLink } }) => (
          <Talk
            id={id}
            title={title}
            type={type}
            date={date}
            event={event}
            eventLink={eventLink}
            video={video}
            image={image}
            slidesLink={slidesLink}
          >
            <p>{excerpt}...</p>
          </Talk>
        ),
      )}
    </div>
    <!-- END Talks  -->

    <!-- Pagination -->
    <div class="grow mt-10 pt-6">
      <div class="text-center dark:text-gray-100">
        <MobilePagination
          currentPage={currentPage}
          noOfPages={noOfPages}
          totalPosts={totalTalks}
          basePath="/talks"
        />
        <DesktopPagination
          currentPage={currentPage}
          noOfPages={noOfPages}
          totalPosts={totalTalks}
          basePath="/talks"
        />
      </div>
    </div>
    <!-- END Pagination -->
  </div>

  <Footer />
</Layout>
